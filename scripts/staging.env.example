# Copy this file to .env.staging.local in the repository root.
# Never commit .env.staging.local.

SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
SUPABASE_ANON_KEY=replace-with-staging-anon-or-publishable-key

# Hard guard: the script runs only when both values below explicitly allow this project ref.
SEED_ALLOWED_REFS=abcdefghijklmnopqrst
SEED_CONFIRM=yes-staging

# One password shared by the four disposable staging test accounts.
SEED_TEST_PASSWORD=replace-with-a-strong-staging-only-password
